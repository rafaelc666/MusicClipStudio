# MusicClipStudio — variáveis de ambiente
# Copie para .env:  cp .env.example .env
# O .env NUNCA é commitado (está no .gitignore).
#
# Todas as chaves são GRATUITAS. Com menos chaves, o app ainda funciona —
# o banco sem chave simplesmente não entra na busca (NASA e Openverse
# funcionam até sem chave, com limite menor).

# ── Bancos de mídia (etapa 01 do Studio explica como criar cada uma) ──
# Pexels   → https://www.pexels.com/api/
STOCK_PEXELS_API_KEY=
# Pixabay  → https://pixabay.com/api/docs/
STOCK_PIXABAY_API_KEY=
# Unsplash → https://unsplash.com/developers
STOCK_UNSPLASH_API_KEY=
# NASA     → https://api.nasa.gov/  (opcional)
STOCK_NASA_API_KEY=
# Coverr   → https://coverr.co  (chave + App ID)
STOCK_COVERR_API_KEY=
STOCK_COVERR_APP_ID=
# Giphy    → https://developers.giphy.com/
STOCK_GIPHY_API_KEY=
# Openverse → https://api.openverse.org/  (opcional)
STOCK_OPENVERSE_API_KEY=

# ── Música de trilha (opcional) ──────────────────────────────
# Epidemic Sound → https://developers.epidemicsound.com/docs/
# ⚠️ NÃO é chave grátis: é a "Partner API" — exige acordo de parceria
# e a chave sai do Developer Portal. Sem ela a busca de trilha fica
# desligada e a Etapa 03 continua com upload manual.
# Licença: o catálogo do parceiro é liberado p/ uso comercial —
# confira o seu acordo antes de monetizar.
EPIDEMIC_API_KEY=

# ── Transcrição (Whisper) — opcional, acelera o download dos modelos ──
# Crie em https://huggingface.co/settings/tokens
HF_TOKEN=

# Gemini (IA do agente): reescreve cada linha da letra em buscas de imagem.
# Sem ela, o agente usa Ollama local e depois as regras fixas.
# Pegue a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chave GENÉRICA de IA (rota por prefixo — Google AIza, Gemini AI Studio
# AQ., Groq gsk_, OpenRouter sk-or-, qualquer OpenAI-compatible sk-).
# Se preenchida, o agente usa pra reescrever cada verso em busca em inglês.
STOCK_IA_API_KEY=

# Google Custom Search JSON API (busca de imagem na web; 100 queries/dia grátis)
# https://console.cloud.google.com/apis/credentials + https://programmablesearchengine.google.com (mecanoso só imagens)
GOOGLE_API_KEY=
STOCK_GOOGLE_CSE_ID=
